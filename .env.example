# =============================================================================
# Multi-Tenant Shared Database — Environment Template
# =============================================================================
# Each tenant gets their own BUILD of this app with a unique .env file.
# All tenants share ONE Supabase project (shared database).
# Tenant data isolation is enforced via Row-Level Security (RLS) using
# the company_id column — populated from VITE_COMPANY_ID at runtime.
# =============================================================================

# Instance Identity — REQUIRED
# Must exactly match the `id` column of a row in the public.tenants table.
# Example values: 'kennydink_moalboal', 'client_001', 'beachpark_cebu'
VITE_COMPANY_ID="tenant_001"

# Supabase Configuration — ALL tenants share the SAME project URL + anon key
VITE_SUPABASE_URL="https://your-shared-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_shared_anon_key"

# Feature Flags
VITE_FEAT_QR_CODES=true
VITE_FEAT_TIME_SLOTS=true
VITE_FEAT_ANALYTICS=true

# Core Theme Colors (Hex)
VITE_THEME_PRIMARY="#14B8A6"
VITE_THEME_PRIMARY_LIGHT="#F0FDFA"
VITE_THEME_PRIMARY_DARK="#0F766E"
VITE_THEME_SECONDARY="#F97316"
VITE_THEME_SECONDARY_LIGHT="#FFF7ED"
